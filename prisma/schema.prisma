generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Profile {
  id          String   @id @default(uuid())
  slug        String   @unique
  name        String
  headline    String
  description String
  location    String
  email       String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  links      Link[]
  skills     Skill[]
  experience Experience[]
  projects   Project[]
}

model Link {
  id        String  @id @default(uuid())
  label     String
  url       String
  sortOrder Int     @default(0)
  profileId String
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, label])
}

model Skill {
  id        String        @id @default(uuid())
  name      String
  category  SkillCategory
  sortOrder Int           @default(0)
  profileId String
  profile   Profile       @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, name])
  @@index([profileId, category])
}

model Experience {
  id           String    @id @default(uuid())
  company      String
  companySite  String?
  position     String
  description  String
  startedAt    DateTime  @db.Date
  finishedAt   DateTime? @db.Date
  achievements String[]
  stack        String[]
  profileId    String
  profile      Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, company, startedAt])
  @@index([profileId, startedAt])
}

model Project {
  id          String   @id @default(uuid())
  name        String
  description String
  demoUrl     String?
  repoUrl     String
  stack       String[]
  sortOrder   Int      @default(0)
  profileId   String
  profile     Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, name])
}

enum SkillCategory {
  LANGUAGE
  FRONTEND
  BACKEND
  DATA
  TESTING
  TOOLING
}
